[node name="HelpText" type="Label" parent="Center/Panel/VBox/HelpWrap"]
layout_mode = 2
text = "← → 或 A / D　左右走动　　空格　跳起（躲箭·落石·水柱，还能踩怪）
J　挥剑攻击（也可鼠标右键）　　双击 左/右　冲刺·跃起（空中再双击=向前飞）
集满 5 个字 → 按 U 放必杀技！　　数字键 1~9　各有特技（翻滚/上挑/震地/回血…）
对白太长？回车 或 鼠标左键 跳过
BOSS 三招：冲刺撞人 / 跳压震地 / 召唤小兵 —— 看红圈预警，跳跃躲开！"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 19
theme_override_colors/font_color = Color(1, 0.96, 0.86, 1)
theme_override_colors/font_outline_color = Color(0.06, 0.03, 0.0, 1)
